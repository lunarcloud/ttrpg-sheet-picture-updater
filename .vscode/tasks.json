{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup (.venv + deps)",
      "type": "shell",
      "command": "${workspaceFolder}/setup.sh",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Format (black + isort)",
      "type": "shell",
      "command": "${workspaceFolder}/format.sh",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Format check (CI-equivalent)",
      "type": "shell",
      "command": "${workspaceFolder}/format.sh --check",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Test: pytest",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "pytest", "tests/", "-v"],
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Regenerate test fixtures",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["tests/fixtures/generate_fixtures.py"],
      "problemMatcher": []
    },
    {
      "label": "Lint shell scripts (shellcheck)",
      "type": "shell",
      "command": "shellcheck",
      "args": [
        "--severity=warning",
        "${workspaceFolder}/setup.sh",
        "${workspaceFolder}/format.sh",
        "${workspaceFolder}/packaging/build-all.sh",
        "${workspaceFolder}/packaging/build-deb.sh",
        "${workspaceFolder}/packaging/build-rpm.sh",
        "${workspaceFolder}/packaging/build-appimage.sh",
        "${workspaceFolder}/packaging/lib/fetch-tools.sh",
        "${workspaceFolder}/packaging/lib/stage-files.sh"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build all packages (.deb/.rpm/AppImage)",
      "type": "shell",
      "command": "${workspaceFolder}/packaging/build-all.sh",
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
