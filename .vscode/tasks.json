{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup (.venv + deps)",
      "type": "shell",
      "command": "${workspaceFolder}/setup.sh",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Format (ruff)",
      "type": "shell",
      "command": "${workspaceFolder}/format.sh",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Format check (CI-equivalent)",
      "type": "shell",
      "command": "${workspaceFolder}/format.sh --check",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Lint (ruff)",
      "type": "shell",
      "command": "${workspaceFolder}/lint.sh",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Type-check (mypy)",
      "type": "shell",
      "command": "${workspaceFolder}/typecheck.sh",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Validate packaging scripts (.spec/.nsi)",
      "type": "shell",
      "command": "${workspaceFolder}/packaging/validate.sh",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Check for outdated dependencies",
      "type": "shell",
      "command": "${workspaceFolder}/package-updates.sh",
      "problemMatcher": []
    },
    {
      "label": "Test: pytest",
      "type": "shell",
      "command": "${workspaceFolder}/test.sh",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Regenerate test fixtures",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["tests/fixtures/generate_fixtures.py"],
      "problemMatcher": []
    },
    {
      "label": "Lint shell scripts (shellcheck)",
      "type": "shell",
      "command": "shellcheck --severity=warning $(find ${workspaceFolder} -name '*.sh' -not -path '*/.venv/*' -not -path '*/build/*' -not -path '*/dist/*')",
      "problemMatcher": []
    },
    {
      "label": "Build all packages (.deb/.rpm/AppImage)",
      "type": "shell",
      "command": "${workspaceFolder}/packaging/build-all.sh",
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
